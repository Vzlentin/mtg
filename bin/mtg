SCHEMA = """
CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE cards (
    oracle_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    layout TEXT,
    mana_cost TEXT,
    cmc REAL,
    type_line TEXT,
    oracle_text TEXT,
    power TEXT,
    toughness TEXT,
    loyalty TEXT,
    defense TEXT,
    colors TEXT,
    color_identity TEXT,
    keywords TEXT,
    legalities TEXT,
    game_changer INTEGER,
    reserved INTEGER,
    edhrec_rank INTEGER,
    game_card INTEGER,
    paper INTEGER,
    first_released TEXT,
    first_set TEXT,
    last_released TEXT,
    eur REAL,
    usd REAL
);
CREATE TABLE faces (
    oracle_id TEXT,
    idx INTEGER,
    name TEXT,
    mana_cost TEXT,
    type_line TEXT,
    oracle_text TEXT,
    power TEXT,
    toughness TEXT,
    loyalty TEXT,
    defense TEXT,
    PRIMARY KEY (oracle_id, idx)
);
CREATE TABLE names (key TEXT, oracle_id TEXT, kind INTEGER, PRIMARY KEY (key, oracle_id, kind));
CREATE TABLE printings (
    id TEXT PRIMARY KEY,
    oracle_id TEXT,
    set_code TEXT,
    collector_number TEXT,
    released_at TEXT,
    rarity TEXT,
    lang TEXT,
    digital INTEGER,
    promo INTEGER,
    eur REAL,
    eur_foil REAL,
    usd REAL,
    usd_foil REAL
);
CREATE TABLE sets (
    code TEXT PRIMARY KEY,
    name TEXT,
    set_type TEXT,
    released_at TEXT,
    card_count INTEGER,
    digital INTEGER,
    parent_set_code TEXT
);
CREATE TABLE rulings (oracle_id TEXT, source TEXT, published_at TEXT, comment TEXT);
CREATE TABLE tags (slug TEXT PRIMARY KEY, label TEXT, description TEXT);
CREATE TABLE tag_parents (slug TEXT, parent_slug TEXT, PRIMARY KEY (slug, parent_slug));
CREATE TABLE card_tags (slug TEXT, oracle_id TEXT, PRIMARY KEY (slug, oracle_id)) WITHOUT ROWID;
CREATE TABLE changes (kind TEXT, oracle_id TEXT, name TEXT, detail TEXT);
"""

INDEXES = """
CREATE INDEX cards_name ON cards (name);
CREATE INDEX names_oracle ON names (oracle_id);
CREATE INDEX printings_oracle ON printings (oracle_id);
CREATE INDEX printings_set ON printings (set_code);
CREATE INDEX rulings_oracle ON rulings (oracle_id);
CREATE INDEX card_tags_oracle ON card_tags (oracle_id);
"""

